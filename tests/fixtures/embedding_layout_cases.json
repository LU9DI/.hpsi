{
  "format": "hpsi-layout-cases",
  "version": 1,
  "note": [
    "One normative table, two independent implementations.",
    "The Rust suite (crates/hpsi-ops/tests/embedding_layout_parity.rs) evaluates",
    "each case through hpsi_ops::validate_entry_layout; the Python suite",
    "(tests/test_embedding_layout_parity.py) evaluates the same case through",
    "audit_hpsi_container.entry_layout_violation. Neither calls the other and",
    "neither reads the other's code: they agree on the code string or the phase",
    "fails. Rules are applied in the documented order, so a case that breaks two",
    "rules reports the first one only - that is asserted here as well.",
    "expect: null means the entry is acceptable; a string is the violation code.",
    "No case here infers anything from a name, a rank or a matching dimension."
  ],
  "cases": [
    {
      "id": "embedding_axis0_valid",
      "source_shape": [32, 16],
      "weight_orientation": "linear_out_in",
      "logical_shape": [32, 16],
      "tensor_role": "embedding_table",
      "index_axis": 0,
      "context": "source",
      "quantized": true,
      "codebook_count": 1,
      "stored_index_bytes": 32,
      "expect": null
    },
    {
      "id": "embedding_axis0_without_orientation",
      "source_shape": [32, 16],
