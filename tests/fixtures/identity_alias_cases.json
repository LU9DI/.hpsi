{
  "format": "hpsi-identity-alias-cases",
  "version": 1,
  "note": [
    "One table, two readers: crates/hpsi-ops/tests/identity_alias_parity.rs and",
    "tests/test_identity_alias_parity.py both feed `manifest` to their own",
    "architecture-manifest parser and compare the outcome. `expect` is null when",
    "the entry is valid, otherwise a distinctive fragment of the reason both",
    "implementations must produce. Neither implementation calls the other and",
    "neither shares code with it: agreement here is evidence about the contract.",
    "A fragment is not a reason code; codes belong to the layout matrix and are",
    "covered by tests/fixtures/embedding_layout_cases.json."
  ],
  "cases": [
    {
      "id": "tied_both_roles_with_pairing",
      "manifest": {
        "format": "hpsi-architecture-manifest",
        "version": 1,
        "model_type": "gpt2",
        "tensors": [
          {
            "name": "transformer.wte.weight",
            "tensor_role": ["embedding_table", "linear_projection"],
            "weight_orientation": "linear_out_in",
            "index_axis": 0,
            "aliases": ["lm_head.weight", "transformer.wte.weight"],
            "role_evidence": [
              {
                "alias": "lm_head.weight",
                "module": "lm_head",
                "module_class": "linear",
                "tensor_role": "linear_projection",
                "weight_orientation": "linear_out_in"
              },
              {
                "alias": "transformer.wte.weight",
                "module": "transformer.wte",
                "module_class": "embedding",
                "tensor_role": "embedding_table",
                "index_axis": 0
              }
            ]
          }
        ]
      },
      "expect": null
    },
    {
      "id": "positional_table_without_orientation",
      "manifest": {
        "format": "hpsi-architecture-manifest",
        "version": 1,
        "model_type": "gpt2",
