          {
            "name": "lm_head.weight",
            "tensor_role": ["linear_projection"],
            "weight_orientation": "linear_out_in",
            "aliases": ["lm_head.weight"],
            "role_evidence": [
              {
                "alias": "lm_head.weight",
                "module": "lm_head",
                "module_class": "linear",
                "tensor_role": "linear_projection",
                "weight_orientation": "linear_out_in"
              }
            ]
          }
        ]
      },
      "expect": null
    },
